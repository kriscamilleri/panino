# One arm of the DX-10 step 8 comparison.
#
# BETTER_SQLITE3_VERSION selects the arm: 9.6.0 is the current production dependency
# (SQLite 3.45.3), 12.11.1 is the DX-10 Phase 2 target (SQLite 3.53.2). Both arms load the
# same vendored CR-SQLite extension so only better-sqlite3's SQLite runtime differs.
#
# NODE_IMAGE stays on Node 20 for both arms by default: Phase 2 isolates the dependency
# change from the runtime change, so the runtime must be held constant here.
ARG NODE_IMAGE=node:20-bookworm-slim
FROM ${NODE_IMAGE}

ARG BETTER_SQLITE3_VERSION=12.11.1

RUN apt-get update -o Acquire::Retries=5 \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		python3 \
		pkg-config \
		libsqlite3-dev \
		ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

ENV PYTHON=/usr/bin/python3
WORKDIR /probe

RUN printf 'ignore-scripts=true\n' > .npmrc \
	&& npm init -y > /dev/null \
	&& npm install --no-audit --no-fund \
		better-sqlite3@${BETTER_SQLITE3_VERSION} \
	&& (cd node_modules/better-sqlite3 && npm run install)

COPY backend/api-service/native/crsqlite.so /probe/crsqlite.so

COPY scripts/dx10-merge-verification/merge-behaviour-probe.mjs \
	scripts/dx10-merge-verification/make-synthetic-fixture.mjs ./

ENV CRSQLITE_EXT_PATH=/probe/crsqlite.so
ENTRYPOINT ["node"]
